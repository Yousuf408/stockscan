[client]
# Hide the toolbar items (share, edit button, menu)
toolbarMode = "minimal"

[logger]
level = "info"

[theme]
primaryColor = "#1a9c4a"
backgroundColor = "#ffffff"
secondaryBackgroundColor = "#f0f0f0"
textColor = "#111111"
font = "sans serif"

[browser]
# Reduce toolbar visibility
gatherUsageStats = false